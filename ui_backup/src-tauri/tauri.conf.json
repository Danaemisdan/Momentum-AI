{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "productName": "Momentum AI",
  "version": "0.1.0",
  "identifier": "com.momentum.ai",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:44445",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../out"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Momentum AI",
        "width": 1100,
        "height": 750,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "maximized": false,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "center": true,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
