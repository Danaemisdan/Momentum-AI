root ::= "{" space "\"thought\"" space ":" space string "," space "\"speech\"" space ":" space string "," space "\"action\"" space ":" space action "}" space
space ::= " "?
string ::= "\"" ([^"\\\x7F\x00-\x1F] | "\\" (["\\/bfnrt] | "u" [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F]))* "\""
number ::= [0-9]+
action ::= chat | navigate | click | type | scroll | key-combo | hold-click | drag | upload-file | ask-user | need-auth | open-tab | switch-tab | close-tab | reflect | search-memory | idle | task-complete | spawn-background | update-intent | check-sub-agent | click-coords | exec-cmd | plan | agent-error
chat ::= "{" space "\"type\"" space ":" space "\"chat\"" space "}"
navigate ::= "{" space "\"type\"" space ":" space "\"navigate\"" "," space "\"url\"" space ":" space string "}"
click ::= "{" space "\"type\"" space ":" space "\"click\"" "," space "\"anchor\"" space ":" space string "," space "\"button\"" space ":" space string "}"
type ::= "{" space "\"type\"" space ":" space "\"type\"" "," space "\"anchor\"" space ":" space string "," space "\"value\"" space ":" space string "}"
scroll ::= "{" space "\"type\"" space ":" space "\"scroll\"" "," space "\"direction\"" space ":" space string "," space "\"amount\"" space ":" space number "}"
key-combo ::= "{" space "\"type\"" space ":" space "\"key_combo\"" "," space "\"key\"" space ":" space string "}"
hold-click ::= "{" space "\"type\"" space ":" space "\"hold_click\"" "," space "\"anchor\"" space ":" space string "}"
drag ::= "{" space "\"type\"" space ":" space "\"drag\"" "," space "\"from_anchor\"" space ":" space string "," space "\"to_anchor\"" space ":" space string "," space "\"button\"" space ":" space string "}"
upload-file ::= "{" space "\"type\"" space ":" space "\"upload_file\"" "," space "\"anchor\"" space ":" space string "," space "\"file_path\"" space ":" space string "}"
ask-user ::= "{" space "\"type\"" space ":" space "\"ask_user\"" "," space "\"message\"" space ":" space string "}"
need-auth ::= "{" space "\"type\"" space ":" space "\"need_auth\"" "," space "\"message\"" space ":" space string "}"
open-tab ::= "{" space "\"type\"" space ":" space "\"open_tab\"" "," space "\"url\"" space ":" space string "}"
switch-tab ::= "{" space "\"type\"" space ":" space "\"switch_tab\"" "," space "\"tab_id\"" space ":" space string "}"
close-tab ::= "{" space "\"type\"" space ":" space "\"close_tab\"" "," space "\"tab_id\"" space ":" space string "}"
reflect ::= "{" space "\"type\"" space ":" space "\"reflect\"" space "}"
search-memory ::= "{" space "\"type\"" space ":" space "\"search_memory\"" "," space "\"query\"" space ":" space string "}"
idle ::= "{" space "\"type\"" space ":" space "\"idle\"" space "}"
task-complete ::= "{" space "\"type\"" space ":" space "\"task_complete\"" space "}"
spawn-background ::= "{" space "\"type\"" space ":" space "\"spawn_background_task\"" "," space "\"skill\"" space ":" space string "," space "\"context\"" space ":" space string "}"
update-intent ::= "{" space "\"type\"" space ":" space "\"update_intent\"" "," space "\"goal\"" space ":" space string "}"
check-sub-agent ::= "{" space "\"type\"" space ":" space "\"check_sub_agent\"" "," space "\"task_id\"" space ":" space string "}"
click-coords ::= "{" space "\"type\"" space ":" space "\"click_coordinates\"" "," space "\"x\"" space ":" space number "," space "\"y\"" space ":" space number "," space "\"button\"" space ":" space string "}"
exec-cmd ::= "{" space "\"type\"" space ":" space "\"execute_command\"" "," space "\"command\"" space ":" space string "}"
plan ::= "{" space "\"type\"" space ":" space "\"plan\"" "," space "\"plan_steps\"" space ":" space string "}"
agent-error ::= "{" space "\"type\"" space ":" space "\"error\"" "," space "\"message\"" space ":" space string "}"
